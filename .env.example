# Local stdio is the default. Use http for a remote Streamable HTTP listener.
MCP_TRANSPORT=stdio

# HTTP bind settings. Hugging Face Docker Spaces expect port 7860.
MCP_HOST=127.0.0.1
PORT=7860

# Required for HTTP in production. Generate a random secret at runtime.
# Do not commit a real value.
MCP_AUTH_TOKEN=

# Local HTTP only. Ignored when NODE_ENV=production.
MCP_ALLOW_UNAUTHENTICATED=false

# Comma-separated hostnames, without ports. localhost and 127.0.0.1 are always included.
MCP_ALLOWED_HOSTS=

# Comma-separated browser origins. Requests with any other Origin are rejected.
# Leave empty to reject every browser Origin. Non-browser clients omit Origin.
MCP_ALLOWED_ORIGINS=

# Set true only behind a trusted reverse proxy that sets X-Forwarded-Proto.
MCP_TRUST_PROXY=false

LOG_LEVEL=info
MCP_MAX_BODY_BYTES=65536
MCP_MAX_SESSIONS=100
MCP_REQUESTS_PER_MINUTE=120
NODE_ENV=development
