{
  "name": "@elatre-ai/mcp-server",
  "version": "1.0.2",
  "description": "Enterprise AI Governance, RBAC Vector Security, Enterprise AI Development, AI Ethics and Governance, Salesforce AI Integration, and NIST/ISO 42001/HIPAA/SOC 2 Readiness Assessment MCP Server.",
  "type": "module",
  "license": "MIT",
  "author": "Elatre",
  "homepage": "https://elatre.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elatre-LLC/elatre-mcp-enterprise-suite.git"
  },
  "bugs": {
    "url": "https://github.com/Elatre-LLC/elatre-mcp-enterprise-suite/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-ethics-and-governance",
    "enterprise-ai-development",
    "enterprise-ai-governance",
    "rbac-vector-security",
    "salesforce-ai-integration",
    "ai-security",
    "ai-compliance",
    "nist-ai-rmf",
    "iso-42001",
    "hipaa-readiness",
    "soc2-readiness",
    "elatre"
  ],
  "bin": {
    "mcp-enterprise-rbac-auditor": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "research/json/contact-information.json",
    "research/json/services.json",
    "research/json/integrations.json",
    "research/json/website-metadata.json",
    "research/json/extraction-report.json",
    "research/markdown/company-profile.md",
    "README.md",
    "LICENSE",
    "smithery.yaml"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "node dist/index.js",
    "start:http": "MCP_TRANSPORT=http node dist/index.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
